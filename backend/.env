# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=Tesabar Search Engine
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-this-in-production-super-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tesabar:tesabar_pass@postgres:5432/tesabar_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300
REDIS_SEARCH_CACHE_TTL=60

# ── Celery ─────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CRAWLER_CONCURRENCY=10
CRAWL_DELAY_SECONDS=0.5
MAX_SITEMAP_URLS=50000

# ── Elasticsearch ──────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ES_INDEX_PRODUCTS=tesabar_products
ES_INDEX_PAGES=tesabar_pages
ES_SHARDS=3
ES_REPLICAS=1

# ── Crawler ────────────────────────────────────────────────────────────────────
CRAWLER_USER_AGENT=TesabarBot/1.0 (+https://tesabar.az/bot)
CRAWLER_TIMEOUT=30
CRAWLER_MAX_RETRIES=3

# ── Ads ────────────────────────────────────────────────────────────────────────
ADS_BOOST_MULTIPLIER=2.0
MIN_BID_AMOUNT=0.01

# ── Admin ──────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@tesabar.az
ADMIN_PASSWORD=zeynalov

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Workers ────────────────────────────────────────────────────────────────────
UVICORN_WORKERS=2
CELERY_CONCURRENCY=4

